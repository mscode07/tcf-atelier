GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Public site origin; set to your actual HTTPS domain in Hostinger.
AUTH_URL=http://localhost:3000

# Supabase Dashboard > Connect > Transaction pooler (PostgreSQL URI).
# Replace [YOUR-PASSWORD] with the database password. Keep this server-only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:6543/postgres

# Find these under Supabase: Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
# Recommended for server-only database operations. Never expose this value.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively, use the anon key together with correctly configured RLS policies.
SUPABASE_ANON_KEY=

# Stripe Checkout one-time Price IDs. Prices themselves are set on the Stripe
# Price objects and can be changed live from the admin Pricing panel.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_7_DAYS=
STRIPE_PRICE_30_DAYS=
STRIPE_PRICE_60_DAYS=
# Admin password: 8+ characters with uppercase, lowercase, a number, and a symbol.
# Quote values containing # or other dotenv-special characters.
# Set a separate random session secret (32+ characters).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Admin file uploads save into this Google Drive folder, in the Drive of
# whichever Google account the admin connects from the Files panel (uses the
# same GOOGLE_CLIENT_ID/SECRET above, plus the drive.file scope).
# 1. Enable the API: https://console.cloud.google.com/apis/library/drive.googleapis.com
# 2. On the OAuth Client used for GOOGLE_CLIENT_ID, add this Authorized
#    redirect URI: <your site origin>/api/admin/drive-auth/callback
# 3. Put the target Drive folder's ID here (from its URL).
GOOGLE_DRIVE_FOLDER_ID=
